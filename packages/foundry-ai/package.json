{
  "name": "@shpitdev/foundry-ai",
  "version": "0.0.10",
  "description": "Thin Palantir Foundry provider adapters and model catalog for the Vercel AI SDK.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shpitdev/foundry-ai.git"
  },
  "homepage": "https://github.com/shpitdev/foundry-ai/tree/main/packages/foundry-ai#readme",
  "bugs": {
    "url": "https://github.com/shpitdev/foundry-ai/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "ai-sdk-provider",
    "foundry",
    "llm-proxy",
    "foundry-provider",
    "palantir",
    "palantir-foundry",
    "ts",
    "vercel-ai-sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.mjs",
      "require": "./dist/providers/openai.cjs"
    },
    "./anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "import": "./dist/providers/anthropic.mjs",
      "require": "./dist/providers/anthropic.cjs"
    },
    "./google": {
      "types": "./dist/providers/google.d.ts",
      "import": "./dist/providers/google.mjs",
      "require": "./dist/providers/google.cjs"
    },
    "./xai": {
      "types": "./dist/providers/xai.d.ts",
      "import": "./dist/providers/xai.mjs",
      "require": "./dist/providers/xai.cjs"
    },
    "./deepseek": {
      "types": "./dist/providers/deepseek.d.ts",
      "import": "./dist/providers/deepseek.mjs",
      "require": "./dist/providers/deepseek.cjs"
    },
    "./nvidia": {
      "types": "./dist/providers/nvidia.d.ts",
      "import": "./dist/providers/nvidia.mjs",
      "require": "./dist/providers/nvidia.cjs"
    },
    "./qwen": {
      "types": "./dist/providers/qwen.d.ts",
      "import": "./dist/providers/qwen.mjs",
      "require": "./dist/providers/qwen.cjs"
    },
    "./moonshot": {
      "types": "./dist/providers/moonshot.d.ts",
      "import": "./dist/providers/moonshot.mjs",
      "require": "./dist/providers/moonshot.cjs"
    },
    "./gemma": {
      "types": "./dist/providers/gemma.d.ts",
      "import": "./dist/providers/gemma.mjs",
      "require": "./dist/providers/gemma.cjs"
    },
    "./realtime": {
      "types": "./dist/providers/realtime.d.ts",
      "import": "./dist/providers/realtime.mjs",
      "require": "./dist/providers/realtime.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.106",
    "@ai-sdk/google": "4.0.122",
    "@ai-sdk/openai": "4.0.121",
    "@ai-sdk/openai-compatible": "3.0.94",
    "ai": "7.0.177",
    "@ai-sdk/xai": "4.0.59"
  },
  "peerDependencies": {
    "ai": "^6.0.141 || ^7.0.0-beta.187",
    "@ai-sdk/anthropic": "^3.0.64 || ^4.0.0-beta.69",
    "@ai-sdk/google": "^3.0.54 || ^4.0.0-beta.85",
    "@ai-sdk/openai": "^3.0.49 || ^4.0.0-beta.77",
    "@ai-sdk/openai-compatible": "^2.0.37 || ^3.0.0-beta.58",
    "@ai-sdk/xai": "^3.0.132 || ^4.0.0-beta.76"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    }
  }
}
