{
  "name": "foundry-ai",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/foundry-ai/src",
  "projectType": "library",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/clean.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "release-policy-check": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-release-policy.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
          "pnpm exec tsup --config tsup.config.ts"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}/packages/foundry-ai"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec oxlint --ignore-pattern 'packages/foundry-effect-ai/**'",
          "pnpm exec oxfmt --check '!packages/foundry-effect-ai/**'",
          "actionlint"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config packages/foundry-ai/vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec vitest run --config packages/foundry-ai/vitest.live.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "package-audit": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-package-contents.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "pnpm exec tsc --project packages/foundry-ai/tsconfig.typecheck.json --noEmit",
            "description": "TypeScript typecheck"
          }
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": [],
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  }
}
