{
  // Emits src as ESM, one file per module, under dist/src.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": [],
    "incremental": false,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
